# GitHub Actions secrets used by .github/workflows/build.yml.
#
# Where to add them: GitHub repository > Settings > Secrets and variables > Actions >
# Secrets tab > New repository secret. Use the names below exactly.
# Or copy this file to .env, fill it in, and upload every entry at once with:
#   gh secret set -f .env
# Repository variables are in .env.variables.example, not here. Release settings (platforms,
# machines, targets, timeouts) are in product.conf.json; the installer formats are
# bundle.targets in apps/desktop/src-tauri/tauri.conf.json.
#
# Values marked "Base64" are file contents, not file paths. On macOS, copy a file as
# Base64 with:
#   base64 -i <file> | pbcopy
#
# Every group is optional. Leave a code signing group empty and that platform is built unsigned;
# the run summary says what was skipped.

# --------------------
# macOS signing and notarization
# Without a certificate, the macOS app gets an ad-hoc signature: Gatekeeper still warns about
# it, but it keeps Apple Silicon Macs from reporting a downloaded app as damaged.
# --------------------

# Base64 of a "Developer ID Application" certificate exported as .p12.
# Get it: developer.apple.com > Certificates, IDs & Profiles > Certificates > create
# "Developer ID Application", install it, then in Keychain Access right-click the
# certificate with its private key > Export > .p12.
APPLE_CERTIFICATE=
# The password you set when exporting that .p12.
APPLE_CERTIFICATE_PASSWORD=

# Base64 of an App Store Connect API key file (AuthKey_XXXXXXXXXX.p8), used for
# notarization. Get it: appstoreconnect.apple.com > Users and Access > Integrations >
# App Store Connect API > Team Keys > generate a key. The .p8 can be downloaded once only.
APPLE_API_KEY=
# The Key ID shown next to that key, for example 2X9R4HXF34.
APPLE_API_KEY_ID=
# The Issuer ID shown above the key list (a UUID).
APPLE_API_ISSUER=

# --------------------
# Windows signing
# --------------------

# Base64 of a Windows code signing certificate file (.pfx) that contains its private key.
# A certificate kept on a hardware token or in a cloud HSM cannot be used here. Leave it
# empty to build unsigned Windows installers.
WINDOWS_CERTIFICATE=
# The password of that .pfx.
WINDOWS_CERTIFICATE_PASSWORD=
# The timestamp server named by the vendor of that certificate, for example
# http://timestamp.digicert.com for a DigiCert certificate. A timestamp keeps the signature
# valid after the certificate expires. Leave it empty to sign without a timestamp.
WINDOWS_TIMESTAMP_URL=

# --------------------
# Update signing
# Installed apps install only updates signed with this key. Leave it empty and the release has
# no update files, so installed apps are not offered it. Installed apps read updates from
# release.updateEndpoints in product.conf.json; {releasesRepository} there is the releases
# repository below, or this repository, which must then be public.
# --------------------

# The contents of a key file created with:
#   pnpm tauri signer generate -w ~/.tauri/sayso.key
# Its public key is the TAURI_SIGNING_PUBLIC_KEY variable in .env.variables.example. Keep the
# key file: installed apps cannot be updated without it.
TAURI_SIGNING_PRIVATE_KEY=
# The password chosen when creating that key.
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# --------------------
# Releases repository
# Set both to publish releases in another repository, for example a public one for a
# private source repository; leave both empty to publish in this repository.
# --------------------

# owner/name of that repository, for example joyx/sayso-releases. Create it on GitHub
# first; it may be empty.
RELEASES_REPOSITORY=
# A fine-grained token that may write releases there. Get it:
# github.com/settings/personal-access-tokens > Generate new token > Repository access:
# Only select repositories > the releases repository > Permissions: Contents > Read and
# write. Renew it before it expires. The value starts with github_pat_.
RELEASES_TOKEN=
