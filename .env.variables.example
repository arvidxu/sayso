# GitHub Actions repository variables used by .github/workflows/build.yml, and
# MAC_SELF_HOSTED_RUNNER also by .github/workflows/check.yml. These are settings, not
# secrets.
#
# Where to add them: GitHub repository > Settings > Secrets and variables > Actions >
# Variables tab > New repository variable. Use the names below exactly.
# Or copy this file to .env.variables, fill it in, and upload every entry at once with:
#   gh variable set -f .env.variables
#
# Every entry is optional; leave it unset to keep the default it describes.

# --------------------
# Self-hosted Mac
# --------------------

# A label of your own Mac registered as a self-hosted runner (Settings > Actions > Runners >
# New self-hosted runner). GitHub gives every self-hosted Mac the label macOS; a custom
# label added when registering it works too. When set, the macOS build and the macOS checks
# of every push to main and every pull request run on that Mac, and wait in the queue while
# it is offline; leave it unset to use GitHub's macOS runner from release.runners.mac in
# product.conf.json.
MAC_SELF_HOSTED_RUNNER=

# --------------------
# Update signing
# --------------------

# The contents of ~/.tauri/sayso.key.pub, the public key of TAURI_SIGNING_PRIVATE_KEY in
# .env.example. The release builds it into the app, which installs only updates signed with
# that key. Required when TAURI_SIGNING_PRIVATE_KEY is set.
TAURI_SIGNING_PUBLIC_KEY=
