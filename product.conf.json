{
  "updates": {
    "firstCheckSeconds": 5,
    "checkIntervalHours": 1,
    "laterHours": 24,
    "checkTimeoutSeconds": 30
  },
  "app": {
    "showWindowAfterSeconds": 3,
    "initialSettings": {
      "automaticUpdates": true
    },
    "home": {
      "periodDays": 30,
      "chartDays": 7,
      "typingWordsPerMinute": 40
    }
  },
  "release": {
    "platforms": {
      "mac": true,
      "windows": true,
      "linux": true
    },
    "runners": {
      "linux": "ubuntu-latest",
      "mac": "xcode-27",
      "windows": "windows-latest"
    },
    "timeoutMinutes": {
      "build": 120,
      "release": 30,
      "checkWait": 120
    },
    "checkWait": {
      "pollSeconds": 30,
      "restartMinutes": 3
    },
    "artifactRetentionDays": 7,
    "retryAttempts": 50,
    "updateEndpoints": [
      "https://github.com/{releasesRepository}/releases/latest/download/latest.json"
    ],
    "desktop": {
      "targets": {
        "mac": ["aarch64-apple-darwin", "x86_64-apple-darwin"],
        "windows": ["x86_64-pc-windows-msvc", "aarch64-pc-windows-msvc"],
        "linux": ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu"]
      },
      "targetRunners": {
        "aarch64-unknown-linux-gnu": "ubuntu-24.04-arm"
      }
    }
  },
  "dictation": {
    "initialSettings": {
      "modelIdleUnloadSecs": 300,
      "audioRetentionDays": 30,
      "maxRecordingSecs": 600,
      "outputTiming": "at-the-end",
      "insertMethod": "paste-with-clipboard-restore",
      "muteOtherAudioWhileRecording": false
    },
    "overrides": {
      "model-store": {
        "localCaches": [
          { "envVar": "HF_HUB_CACHE", "subPath": "", "filePattern": "*/blobs/{sha256}" },
          { "envVar": "HF_HOME", "subPath": "hub", "filePattern": "*/blobs/{sha256}" },
          { "envVar": "XDG_CACHE_HOME", "subPath": "huggingface/hub", "filePattern": "*/blobs/{sha256}" },
          { "envVar": null, "subPath": ".cache/huggingface/hub", "filePattern": "*/blobs/{sha256}" }
        ]
      }
    }
  }
}
