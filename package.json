{
  "name": "sayso",
  "license": "AGPL-3.0-only",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.22.3",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm --filter ./apps/desktop tauri dev",
    "tauri": "pnpm --filter ./apps/desktop tauri",
    "build": "pnpm --filter ./apps/desktop build",
    "lint": "pnpm --filter ./apps/desktop lint",
    "fmt": "pnpm --filter ./apps/desktop fmt",
    "fmt:check": "pnpm --filter ./apps/desktop fmt:check",
    "check": "pnpm lint && pnpm fmt:check && pnpm test && pnpm build",
    "test": "node --test scripts/release/*.test.mjs apps/desktop/tests/*.test.ts"
  },
  "private": true
}
